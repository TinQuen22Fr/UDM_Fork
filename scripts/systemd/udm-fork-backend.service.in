[Unit]
Description=UDM Fork — Sky Quality Meter backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__/backend
ExecStart=__ROOT__/backend/.venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8001
EnvironmentFile=__ROOT__/backend/.env
Restart=on-failure
RestartSec=3
# Soft sandboxing (user service has limited tightening anyway)
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
