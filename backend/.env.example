# Backend environment example.
# Copy to .env and edit before first run.

# MongoDB (optional — used for preferences only)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="udm_fork"

# CORS origins (comma separated)
CORS_ORIGINS="*"

# Set SQM_MOCK=1 to enable two synthetic devices (FTDI + CH340)
# so you can try the UI without any hardware connected.
SQM_MOCK="0"

# Directories used for runtime data
SQM_LOG_DIR="./logs"
SQM_FIRMWARE_DIR="./firmware"
